{
  "datasets": [
    {
      "name": "gold_anomaly_scores",
      "displayName": "Gold Anomaly Scores",
      "queryLines": [
        "SELECT\n",
        "  item_id,\n",
        "  check_type,\n",
        "  customer_id,\n",
        "  account_name,\n",
        "  amount_at_risk,\n",
        "  isolation_forest_score,\n",
        "  zscore,\n",
        "  composite_anomaly_score,\n",
        "  anomaly_rank,\n",
        "  review_priority\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.gold_anomaly_scores"
      ]
    },
    {
      "name": "gold_leakage_summary",
      "displayName": "Canonical Open Exception Workflow",
      "queryLines": [
        "SELECT\n",
        "  exception_id,\n",
        "  check_type,\n",
        "  severity,\n",
        "  customer_id,\n",
        "  account_name,\n",
        "  amount_at_risk,\n",
        "  known_leakage_flag,\n",
        "  status,\n",
        "  assignee,\n",
        "  case_version,\n",
        "  latest_note,\n",
        "  latest_note_author,\n",
        "  note_count,\n",
        "  case_updated_at\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.gold_exception_workflow\n",
        "WHERE status NOT IN ('Recovered', 'WrittenOff')"
      ]
    },
    {
      "name": "doc_invoices",
      "displayName": "Doc Intelligence - Invoices",
      "queryLines": [
        "SELECT\n",
        "  doc_invoice_number,\n",
        "  doc_total_amount,\n",
        "  db_invoice_amount,\n",
        "  amount_mismatch,\n",
        "  amount_variance\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.silver_doc_intelligence_invoices"
      ]
    },
    {
      "name": "gold_scorecard",
      "displayName": "Gold Reconciliation Scorecard",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  account_name,\n",
        "  composite_health_score,\n",
        "  CASE\n",
        "    WHEN composite_health_score < 50 THEN 'RED'\n",
        "    WHEN composite_health_score < 65 THEN 'AMBER'\n",
        "    ELSE 'GREEN'\n",
        "  END AS risk_tier,\n",
        "  price_accuracy_score,\n",
        "  discount_compliance_score,\n",
        "  total_amount_at_risk,\n",
        "  total_exceptions\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.gold_reconciliation_scorecard\n",
        "ORDER BY\n",
        "  total_amount_at_risk DESC\n",
        "LIMIT 100"
      ]
    },
    {
      "name": "doc_contracts",
      "displayName": "Doc Intelligence - Contracts",
      "queryLines": [
        "SELECT\n",
        "  doc_contract_number,\n",
        "  doc_sla_tier,\n",
        "  db_sla_tier,\n",
        "  sla_mismatch,\n",
        "  term_mismatch,\n",
        "  total_mismatches,\n",
        "  account_name\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.silver_doc_intelligence_contracts"
      ]
    },
    {
      "name": "forecast",
      "displayName": "Revenue Forecast vs Actuals",
      "queryLines": [
        "SELECT\n",
        "  revenue_month,\n",
        "  actual_revenue,\n",
        "  forecast_revenue,\n",
        "  forecast_upper_bound,\n",
        "  forecast_lower_bound,\n",
        "  budget_amount,\n",
        "  budget_variance_pct,\n",
        "  anomaly_status\n",
        "FROM\n",
        "  cdm_tmforum.revenue_assurance.gold_revenue_forecast_anomalies\n",
        "ORDER BY\n",
        "  revenue_month"
      ]
    }
  ],
